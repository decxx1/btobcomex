---
import Layout from "@/layouts/Layout.astro";
import Hero from "@/components/Hero.astro";
import HeaderTitle from "@/components/HeaderTitle.astro";
import CTAExperience2 from "@/components/canton-fair/CTAExperience2.astro";
import ProgramForm from "@/components/canton-fair/ProgramForm.astro";
import Itinerary from "@/components/canton-fair/Itinerary.astro";
import FairSchedule from "@/components/canton-fair/FairSchedule.astro";
import { SITE_KEY } from "astro:env/client";

const preloadImages = [
	{
		href: "/assets/images/AAch03.webp",
		as: "image",
		type: "image/webp",
	},
];
---

<Layout
	title="B TO B Comex - Feria de Cantón"
	canonical="https://btobcomex.com/canton-fair"
	metaDescription="Conocé todo sobre la Feria de Cantón, Viajá a la Feria de Cantón con nosotros y viví el evento de negocios más importante del mundo con el acompañamiento adecuado."
	metaImg="/assets/images/AAch03.webp"
	preLoad={preloadImages}
>
	<Hero
		bgImage="/assets/images/AAch03.webp"
		title="Tu puente entre <br /> el comercio y el mundo"
		showBottomBar={true}
	/>

	<HeaderTitle title="FERIA DE CANTÓN" isRed={true} />
	
	<CTAExperience2 />
	
	<ProgramForm />
	<section class="relative">
		<img
			src='/assets/images/hermosa-arquitectura-de-la-ciudad-de-taipei.webp'
			alt=""
			class="h-640 sm:h-480 w-auto lg:w-full lg:h-auto -z-10 absolute top-0 xl:-top-40 2xl:-top-80 left-0 scale-x-[-1] object-cover object-top-center md:object-top-left"
		/>
	</section>
	
	<Itinerary />
	
	<FairSchedule />
</Layout>

<!-- recaptcha v3 -->
<script async src={'https://www.google.com/recaptcha/api.js?render=' + SITE_KEY} data-astro-rerun></script>

---
import Layout from "@/layouts/Layout.astro";
import Hero from "@/components/Hero.astro";
import HeaderTitle from "@/components/HeaderTitle.astro";
import CTAExperience from "@/components/yiwu-market/CTAExperience.astro";
import WhyChooseUs from "@/components/yiwu-market/WhyChooseUs.astro";
import OurServices from "@/components/yiwu-market/OurServices.astro";
import OperationalInfrastructure from "@/components/yiwu-market/OperationalInfrastructure.astro";
import HowWeWork from "@/components/yiwu-market/HowWeWork.astro";
import ImportCTA from "@/components/yiwu-market/ImportCTA.astro";
import { SITE_KEY } from "astro:env/client";

const preloadImages = [
	{
		href: "/assets/images/yiwu-market/yiwu.webp",
		as: "image",
		type: "image/webp",
	},
];
---

<Layout
	title="B TO B Comex - Mercado de Yiwu | Importación desde China"
	canonical="https://btobcomex.com/yiwu-market"
	metaDescription="Importá desde el Mercado Internacional de Yiwu con B TO B Comex. Equipo local en China, validación de proveedores. Acompañamiento integral en español desde la búsqueda de proveedores hasta el embarque."
	metaImg="/assets/images/yiwu-market/yiwu.webp"
	preLoad={preloadImages}
>
	<Hero
		bgImage="/assets/images/yiwu-market/yiwu.webp"
		title="Tu puente entre <br /> el comercio y el mundo"
		showBottomBar={false}
	/>

	<HeaderTitle title="MERCADO DE YIWU" isRed={true} />
	
	<CTAExperience />

	<WhyChooseUs />

	<OurServices />

	<OperationalInfrastructure />

	<HowWeWork />

	<ImportCTA />
</Layout>

<!-- recaptcha v3 -->
<script async src={'https://www.google.com/recaptcha/api.js?render=' + SITE_KEY} data-astro-rerun></script>

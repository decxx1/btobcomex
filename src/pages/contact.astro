---
import Layout from "@/layouts/Layout.astro";
import BreadCrumbs from "@/components/BreadCrumbs.astro";
import HeaderTitle from "@/components/HeaderTitle.astro";
import ContactInfo from "@/components/contact/ContactInfo.astro";
import { SITE_KEY } from "astro:env/client";

const preloadImages = [
	{
		href: "/assets/images/piedra-deg.webp",
		as: "image",
		type: "image/webp",
	},
];
---

<Layout
	title="B TO B Comex - Contacto"
	canonical="https://btobcomex.com/contact"
	metaDescription="Contactá con B TO B Comex para consultas sobre comercio internacional. Estamos aquí para ayudarte."
	metaImg="/assets/images/vista-aerea-del-buque-de-c3arga-de-contenedores-en-el-mar.webp"
	preLoad={preloadImages}
>
	<BreadCrumbs
		bgImage="/assets/images/piedra-deg.webp"
		title="Tu puente entre <br /> el comercio y el mundo"
		showBottomBar={false}
	/>

	<HeaderTitle title="CONTACTO" isRed={false} />
	
	<ContactInfo />
</Layout>

<!-- recaptcha v3 -->
<script async src={'https://www.google.com/recaptcha/api.js?render=' + SITE_KEY} data-astro-rerun></script>
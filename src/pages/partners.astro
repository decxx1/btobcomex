---
import Layout from "@/layouts/Layout.astro";
import BreadCrumbs from "@/components/BreadCrumbs.astro";
import HeaderTitle from "@/components/HeaderTitle.astro";
import PartnersLogos from "@/components/partners/PartnersLogos.astro";

const preloadImages = [
	{
		href: "/assets/images/Piedra-verde.webp",
		as: "image",
		type: "image/webp",
	},
];
---

<Layout
	title="B TO B Comex - Partners Estratégicos"
	canonical="https://btobcomex.com/partners"
	metaDescription="Conocé a nuestros partners estratégicos en B TO B Comex. Colaboramos con las mejores empresas para ofrecer soluciones integrales en comercio exterior."
	metaImg="/assets/images/vista-aerea-del-buque-de-c3arga-de-contenedores-en-el-mar.webp"
	preLoad={preloadImages}
>
	<BreadCrumbs
		bgImage="/assets/images/Piedra-verde.webp"
		title="Tu puente entre <br /> el comercio y el mundo"
		showBottomBar={false}
	/>

	<HeaderTitle title="PARTNERS ESTRATÉGICOS" isRed={false} />
	
	<PartnersLogos />
</Layout>

---
import CantonLogo from "@/components/CantonLogo.astro";
import { SOCIAL_WHATSAPP_URL } from "astro:env/client";

interface Props {
	bgImages: string[];
}

const { bgImages } = Astro.props;
const whatsappUrl = SOCIAL_WHATSAPP_URL ?? "";
---

<section class="relative h-dvh w-full overflow-hidden font-montserrat">
	<!-- Background Images Carousel -->
	<div class="absolute inset-0 z-0" id="hero-carousel">
		{bgImages.map((image, index) => (
			<img
				src={image}
				alt={`Hero Background ${index + 1}`}
				class:list={[
					"carousel-slide absolute inset-0 w-full h-full object-cover transition-opacity duration-1000 ease-in-out",
					index === 0 ? "opacity-100" : "opacity-0"
				]}
				data-index={index}
			/>
		))}
		<!-- Dark Overlay -->
		<div class="absolute inset-0 mask-b-from-10% mask-b-to-60% bg-black/70">
		</div>
	</div>

	<!-- Right Arrow Mask Overlay -->
	<!-- Positioned absolutely to the right, taking up full height -->
	<div
		class="absolute top-0 right-0 h-full w-[60%] lg:w-[40%] z-10 pointer-events-none hidden md:block"
	>
		<img
			src="/assets/elements/arrow-right.svg"
			alt="elemento decorativo"
			class="h-full w-full object-cover object-left opacity-20 mix-blend-multiply"
		/>
	</div>

	<!-- Content -->
	<div
		class="relative z-20 container mx-auto h-full flex flex-col justify-center px-4 md:px-12 text-white sm:pt-20"
	>
		<h1 class="max-sm:text-center text-3xl sm:text-4xl md:text-5xl xl:text-6xl font-bold leading-tight max-w-3xl xl:max-w-4xl shadow-xx">
			Viví la Feria de Cantón <br /> <span class='block mt-2 min-h-[1.2em]' id="dynamic-hero-title"></span>
		</h1>
	</div>

	<!-- Bottom Elements -->
	<div class="absolute bottom-0 left-0 w-full z-30">
		<div class="container mx-auto flex flex-col sm:flex-row items-center gap-6 md:gap-12 pb-12 md:pb-16">
			<!-- Anniversary Badge (Red Bar) -->
			<CantonLogo />

			<!-- CTA Button -->
			<a
				href={whatsappUrl}
				target="_blank"
				class="group bg-radial from-rojo to-[#6d0000] hover:bg-[#6d0000] text-white py-1 xl:py-2 px-6 xl:px-8 rounded-tr-2xl rounded-tl-2xl rounded-bl-2xl flex flex-col items-start text-left transition-all shadow-lg hover:shadow-xl hover:-translate-y-1"
			>
				<span class="text-lg xl:text-xl font-semibold 2xl:font-bold">
					Reservá tu lugar
				</span>
				<span
					class="text-sm xl:text-base font-light xl:font-medium opacity-90 min-h-[1.5em] inline-block"
					id="dynamic-hero-btn"
				>
				</span>
			</a>
		</div>
	</div>
</section>

<script>
	document.addEventListener('astro:page-load', () => {
		// Set dynamic dates
		const today = new Date();
		const currentYear = today.getFullYear();
		const currentMonth = today.getMonth();
		const currentDay = today.getDate();

		let targetMonthName = "Abril";
		let targetYear = currentYear;

		if (currentMonth > 9 || (currentMonth === 9 && currentDay >= 10)) {
			targetMonthName = "Abril";
			targetYear = currentYear + 1;
		} else if (currentMonth > 3 || (currentMonth === 3 && currentDay >= 10)) {
			targetMonthName = "Octubre";
			targetYear = currentYear;
		} else {
			targetMonthName = "Abril";
			targetYear = currentYear;
		}

		const dynamicText = `${targetMonthName} ${targetYear}`;
		
		const titleEl = document.getElementById("dynamic-hero-title");
		if (titleEl) titleEl.textContent = dynamicText;
		
		const btnEl = document.getElementById("dynamic-hero-btn");
		if (btnEl) btnEl.textContent = `Feria de Cantón ${dynamicText}`;

		// Carousel logic
		const slides = document.querySelectorAll<HTMLImageElement>('.carousel-slide');
		if (slides.length <= 1) return;

		let currentIndex = 0;
		const totalSlides = slides.length;
		const intervalTime = 5000; // 5 segundos entre cada imagen

		const nextSlide = () => {
			// Ocultar slide actual
			slides[currentIndex].classList.remove('opacity-100');
			slides[currentIndex].classList.add('opacity-0');

			// Avanzar al siguiente
			currentIndex = (currentIndex + 1) % totalSlides;

			// Mostrar nuevo slide
			slides[currentIndex].classList.remove('opacity-0');
			slides[currentIndex].classList.add('opacity-100');
		};

		// Iniciar carrusel automático
		setInterval(nextSlide, intervalTime);
	});
</script>

---
import HeaderTitle from "@/components/HeaderTitle.astro";
---

<HeaderTitle title="INFRAESTRUCTURA OPERATIVA EN YIWU" />

<section class="bg-linear-to-b from-crema-deg-1 to-crema text-verde-deg-1 relative overflow-hidden">
	<!-- Arrow + Image Container -->
	<div class="relative flex items-stretch -mt-4 lg:-mt-8">
		<!-- Arrow SVG -->
		<div class="overflow-hidden max-md:hidden w-[28%] lg:w-5xl xl:w-304 2xl:w-360 absolute z-10 -top-64 -left-96 shrink-0 self-stretch">
			<img
				src="/assets/icons/yiwu/arrow-white-left.svg"
				alt=""
				class="h-full w-full object-cover object-right"
			/>
		</div>

		<!-- Image with diagonal cut that continues from arrow -->
		<div class="grow relative md:ml-20 xl:ml-42 2xl:ml-66">
			<div
				class="scale-200 xs:scale-150 sm:scale-100 h-28 xs:h-36 sm:h-44 md:h-full w-full lg:w-5xl xl:w-328 2xl:w-352 shadow-xl md:[clip-path:polygon(32%_0,100%_0,100%_100%,0%_100%)] xl:[clip-path:polygon(32%_0,100%_0,100%_100%,0%_100%)] 2xl:[clip-path:polygon(40%_0,100%_0,100%_100%,0%_100%)]"
			>
				<img
					src="/assets/images/yiwu-market/market.jpeg"
					alt="Mercado Internacional de Yiwu"
					class="w-full h-full object-cover object-top min-h-28 xs:min-h-36 sm:min-h-44 md:min-h-64 max-h-80 lg:max-h-82 xl:max-h-109 2xl:min-h-72 2xl:max-h-141"
				/>
			</div>
		</div>
	</div>

	<!-- Text Content -->
	<div class="container pb-16 sm:pb-20 px-4 md:px-12 mt-12 sm:mt-8 lg:mt-10 md:ml-20 lg:ml-60 xl:ml-80 2xl:ml-104">
		<div class="flex justify-center sm:justify-start">
			<div class="sm:max-w-xl xl:max-w-2xl text-center md:text-left mt-12 md:mt-0">
				<p class="md:-ml-10 text-base xs:text-base md:text-lg xl:text-xl font-bold leading-relaxed">
					Nuestro centro de operaciones permite recibir, verificar y consolidar mercadería antes de su despacho internacional.
				</p>

				<ul class="mt-8 space-y-2 text-base xs:text-base md:text-lg xl:text-xl font-medium text-left">
					<li class="pl-0">- Recepción y control de pedidos.</li>
					<li class="pl-0 md:pl-10">- Registro fotográfico de la carga.</li>
					<li class="pl-0 md:pl-20">- Almacenamiento temporal.</li>
					<li class="pl-0 md:pl-32">- Consolidación de contenedores.</li>
					<li class="pl-0 md:pl-44">- Coordinación con agentes logísticos internacionales.</li>
				</ul>
			</div>
		</div>
	</div>
</section>

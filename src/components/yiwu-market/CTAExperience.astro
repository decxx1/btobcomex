---

---

<section class="relative mt-8">
	<!-- Background Image -->
	<div class="sm:absolute inset-0 z-0">
		<img
			src="/assets/images/yiwu-market/market2.jpg"
			alt="Mercado de Yiwu"
			class="w-full h-full object-cover"
		/>
	</div>

	<!-- Content -->
	<div 
		class="max-sm:-mt-41 bg-semi-black/80 sm:bg-semi-black relative z-10 sm:[clip-path:polygon(0_0,20%_0,50%_100%,0_100%)]"
	>
		<div class="container mx-auto px-4 md:px-8 py-1 sm:py-16 lg:py-28">
			<div class="max-w-lg">
				<h2 class="max-sm:text-center text-xl md:text-2xl lg:text-3xl xl:text-4xl text-white leading-tight">
					<span class="font-bold italic">Importá <br class="max-sm:hidden" />desde Yiwu</span><br />
					<span class="font-light">Con el respaldo<br /> de un equipo<br /> en China.</span>
				</h2>
			</div>
		</div>
	</div>
</section>

<!-- Quote Section -->
<section class="py-8 sm:py-10 lg:py-14 mt-16 sm:mt-2">
    <div class="container mx-auto px-4 md:px-12">
        <div class="max-sm:px-2 flex items-stretch justify-center gap-4 md:gap-6 max-w-4xl mx-auto">
            <!-- Text -->
            <p class="text-lg sm:text-xl lg:text-3xl font-medium sm:font-light text-semi-black text-center leading-normal py-4">
                <span class="bg-black text-white p-1">Conectamos empresas latinoamericanas con el Mercado 
				Internacional de Yiwu, el mayor mercado mayorista de 
				productos de consumo del mundo.</span><br />
				A través de nuestro equipo local y nuestra experiencia 
				en comercio internacional, <span class="bg-black text-white p-1">te acompañamos en cada etapa 
				del proceso: desde la búsqueda de proveedores hasta la 
				coordinación de tu importación.</span>
            </p>
            
        </div>
    </div>
</section>

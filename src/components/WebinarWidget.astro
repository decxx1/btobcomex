---
import { SOCIAL_WHATSAPP_URL } from "astro:env/client";

const whatsappUrl = SOCIAL_WHATSAPP_URL ?? "";

const webinars = [
	{
		id: "2026-08-31-1100",
		label: "Lunes 31 de agosto",
		shortLabel: "Lun 31/8",
		dateLabel: "31 de agosto",
		sessionLabel: "Mañana",
		time: "11:00 a 12:30 hs",
		summaryTime: "11:00 h",
		startAt: "2026-08-31T11:00:00-03:00",
		endAt: "2026-08-31T12:30:00-03:00",
		confirmUrl: "https://meet.google.com/pgx-szef-vza",
	},
	{
		id: "2026-08-31-1900",
		label: "Lunes 31 de agosto",
		shortLabel: "Lun 31/8",
		dateLabel: "31 de agosto",
		sessionLabel: "Tarde",
		time: "19:00 a 20:30 hs",
		summaryTime: "19:00 h",
		startAt: "2026-08-31T19:00:00-03:00",
		endAt: "2026-08-31T20:30:00-03:00",
		confirmUrl: "https://meet.google.com/jqu-miif-dck",
	},
	{
		id: "2026-09-02-1100",
		label: "Miércoles 2 de septiembre",
		shortLabel: "Mié 2/9",
		dateLabel: "2 de septiembre",
		sessionLabel: "Mañana",
		time: "11:00 a 12:30 hs",
		summaryTime: "11:00 h",
		startAt: "2026-09-02T11:00:00-03:00",
		endAt: "2026-09-02T12:30:00-03:00",
		confirmUrl: "https://meet.google.com/fai-kdhj-ohw",
	},
	{
		id: "2026-09-02-1900",
		label: "Miércoles 2 de septiembre",
		shortLabel: "Mié 2/9",
		dateLabel: "2 de septiembre",
		sessionLabel: "Tarde",
		time: "19:00 a 20:30 hs",
		summaryTime: "19:00 h",
		startAt: "2026-09-02T19:00:00-03:00",
		endAt: "2026-09-02T20:30:00-03:00",
		confirmUrl: "https://meet.google.com/bwe-ymwb-enu",
	},
	{
		id: "2026-09-04-1100",
		label: "Viernes 4 de septiembre",
		shortLabel: "Vie 4/9",
		dateLabel: "4 de septiembre",
		sessionLabel: "Mañana",
		time: "11:00 a 12:30 hs",
		summaryTime: "11:00 h",
		startAt: "2026-09-04T11:00:00-03:00",
		endAt: "2026-09-04T12:30:00-03:00",
		confirmUrl: "https://meet.google.com/bnd-ghdo-vhy",
	},
	{
		id: "2026-09-04-1900",
		label: "Viernes 4 de septiembre",
		shortLabel: "Vie 4/9",
		dateLabel: "4 de septiembre",
		sessionLabel: "Tarde",
		time: "19:00 a 20:30 hs",
		summaryTime: "19:00 h",
		startAt: "2026-09-04T19:00:00-03:00",
		endAt: "2026-09-04T20:30:00-03:00",
		confirmUrl: "https://meet.google.com/hwt-rtxz-jwn",
	},
];

const MONTH_ABBR = ["Ene", "Feb", "Mar", "Abr", "May", "Jun", "Jul", "Ago", "Sep", "Oct", "Nov", "Dic"];

function toSummaryDateLabel(startAt: string) {
	const [, month, day] = startAt.slice(0, 10).split("-");
	return `${Number(day)} ${MONTH_ABBR[Number(month) - 1]}`;
}

const webinarsWithSummary = webinars.map((webinar) => ({
	...webinar,
	summaryDateLabel: toSummaryDateLabel(webinar.startAt),
}));

const webinarDateSummary = [...new Set(webinarsWithSummary.map(({ summaryDateLabel }) => summaryDateLabel))].join("\n");
const webinarTimeSummary = [...new Set(webinarsWithSummary.map(({ summaryTime }) => summaryTime))].join(" y ");
---

<div id="webinar-widget" class="font-montserrat" data-webinars={JSON.stringify(webinarsWithSummary)}>
	<!-- Modal popup -->
	<div
		id="webinar-modal"
		class="webinar-modal fixed inset-0 z-60 overflow-y-auto overscroll-contain opacity-0 pointer-events-none transition-opacity duration-300"
		aria-hidden="true"
		role="dialog"
		aria-labelledby="webinar-title"
		aria-modal="true"
	>
		<div
			class="webinar-backdrop fixed inset-0 bg-verde-deg-black/80 backdrop-blur-sm"
			data-webinar-close
		></div>

		<div class="relative z-10 flex min-h-full w-full items-center justify-center p-4 py-6 sm:p-6 sm:py-8">
		<div
			class="webinar-card relative my-auto w-full max-w-6xl rounded-lg shadow-2xl translate-y-4 scale-[0.97] transition-all duration-300"
		>
			<button
				type="button"
				class="cursor-pointer absolute top-3 right-3 z-30 flex size-9 items-center justify-center rounded-full bg-black/40 text-white transition-colors hover:bg-black/60 focus:outline-none focus-visible:ring-2 focus-visible:ring-verde-claro"
				data-webinar-close
				aria-label="Cerrar invitación al webinar"
			>
				<svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
					<path d="M18 6L6 18M6 6l12 12" stroke-linecap="round"></path>
				</svg>
			</button>

			<div class="relative overflow-hidden rounded-lg">
				<img
					src="/assets/images/webinar/webinar-bg.webp"
					alt=""
					class="absolute inset-0 size-full object-cover"
					loading="eager"
				/>
				

				<div class="relative px-5 pb-8 pt-0 sm:px-8 sm:pb-10 md:px-10 md:pb-12">
					<div class="relative mx-auto -mt-px w-96">
						<img
							src="/assets/icons/webinar/shape-top.svg"
							alt="figura banner webinar"
							class="w-full -mt-6"
							aria-hidden="true"
						/>
						<img
							src="/assets/logos/logo-color-green.svg"
							alt="B TO B Comex"
							class="absolute left-1/2 top-20 w-42 -translate-x-1/2 -translate-y-1/2"
						/>
					</div>

					<div class="mt-4 flex flex-col gap-6 md:mt-6 md:gap-8">
						<div class="grid items-center gap-4 py-4 md:grid-cols-2 sm:gap-6 sm:py-6 md:py-8">
							<div class="flex items-center justify-center">
								<h2 class="text-5xl font-bold leading-none sm:text-6xl md:text-6xl lg:text-7xl">
									<span class="text-crema">Web</span><span class="text-white">inar</span>
								</h2>
								<img
									src="/assets/icons/webinar/voice-chat.svg"
									alt="Icono de voz y chat"
									class="size-16 sm:size-20 md:size-24 lg:size-28 -mt-14"
									aria-hidden="true"
								/>
							</div>

							<div class="relative flex items-center justify-center px-2 py-4 sm:px-4 sm:py-6">
								<div class="webinar-flare webinar-flare--top" aria-hidden="true"></div>
								<h3
									id="webinar-title"
									class="webinar-title-shadow relative text-center text-2xl font-bold leading-tight text-white md:text-3xl lg:text-4xl"
								>
									Claves para viajar a la Feria de Cantón 2026
								</h3>
								<div class="webinar-flare webinar-flare--bottom" aria-hidden="true"></div>
							</div>
						</div>

						<div class="flex flex-col gap-6 lg:flex-row lg:items-stretch lg:gap-8">
							<div class="flex flex-1 items-center justify-center px-2 py-2 sm:px-4 sm:py-4">
								<p class="webinar-bracketed text-center font-medium leading-snug text-white text-base md:text-lg shadow">
									<b>Todo lo que necesitás saber</b><br> para aprovechar la feria y generar oportunidades
									comerciales.
								</p>
							</div>

							<div
								class="webinar-info-box flex shrink-0 items-stretch justify-center gap-0 bg-crema/20 px-4 py-4 backdrop-blur-sm sm:px-5 sm:py-5 lg:w-[min(440px,48%)]"
							>
								<div class="webinar-info-item webinar-info-item--dates">
									<img src="/assets/icons/webinar/calendar.svg" alt="" class="webinar-info-icon" />
									<span data-webinar-summary-date class="webinar-summary-text">{webinarDateSummary}</span>
								</div>
								<div class="webinar-info-divider" aria-hidden="true"></div>
								<div class="webinar-info-item">
									<img src="/assets/icons/webinar/clock.svg" alt="" class="webinar-info-icon" />
									<span data-webinar-summary-time class="webinar-summary-text">{webinarTimeSummary}</span>
								</div>
								<div class="webinar-info-divider" aria-hidden="true"></div>
								<div class="webinar-info-item">
									<img src="/assets/icons/webinar/meet.svg" alt="" class="webinar-info-icon" />
									<span>Google<br />meet</span>
								</div>
								<div class="webinar-info-divider" aria-hidden="true"></div>
								<div class="webinar-info-item">
									<img src="/assets/icons/webinar/free.svg" alt="" class="webinar-info-icon" />
									<span>Gratuito</span>
								</div>
							</div>
						</div>

						<div class="mx-auto max-w-5xl px-2 pt-2 sm:px-4">
							<p class="text-center shadow text-sm leading-relaxed text-white/90 sm:text-base">
								<b class="font-bold">Elegí la fecha y el horario que prefieras</b> e ingresá al webinar por Google Meet. Es
								gratuito y no necesitás instalar nada.
							</p>

							<div class="webinar-carousel mx-auto mt-4 w-full max-w-2xl sm:max-w-3xl">
								<div class="webinar-carousel-inner">
									<button
										type="button"
										data-webinar-carousel-prev
										class="webinar-carousel-nav webinar-carousel-nav--prev"
										aria-label="Ver fechas anteriores"
									>
										<svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
											<path d="M15 18l-6-6 6-6" stroke-linecap="round" stroke-linejoin="round"></path>
										</svg>
									</button>

									<div data-webinar-cards class="webinar-carousel-track grid w-full gap-3 sm:grid-cols-2">
								{
									webinarsWithSummary.map((webinar) => (
										<a
											data-webinar-card
											data-webinar-id={webinar.id}
											data-webinar-date={webinar.startAt.slice(0, 10)}
											data-webinar-start={webinar.startAt}
											data-webinar-end={webinar.endAt}
											href={webinar.confirmUrl}
											target="_blank"
											rel="noopener noreferrer"
											aria-label={`Ingresar al webinar ${webinar.sessionLabel} — ${webinar.label} a las ${webinar.time}`}
											class="webinar-day-card group w-full flex-col rounded-xl border border-white/25 bg-white/10 p-3 text-left backdrop-blur-sm transition-all hover:-translate-y-1 hover:border-crema/50 hover:bg-white/15 focus:outline-none focus-visible:ring-2 focus-visible:ring-verde-claro sm:p-4"
										>
											<div class="mb-2 flex items-center justify-between gap-2">
												<span class="rounded-full bg-crema/20 px-2.5 py-0.5 text-xs font-semibold uppercase tracking-wide text-crema">
													{webinar.sessionLabel}
												</span>
												<img
													src="/assets/icons/webinar/meet.svg"
													alt=""
													class="size-5 shrink-0 opacity-90"
													aria-hidden="true"
												/>
											</div>

											<h4 class="text-base font-bold leading-tight text-white sm:text-lg">
												<span class="sm:hidden">{webinar.shortLabel}</span>
												<span class="hidden sm:inline">{webinar.label}</span>
											</h4>

											<p class="mt-1 text-sm text-white/80">{webinar.time}</p>
											<p class="mt-0.5 text-xs text-white/60">Hora de Argentina</p>

											<span class="mt-3 inline-flex items-center gap-1.5 text-sm font-semibold text-verde-claro transition-colors group-hover:text-white">
												Ingresar
												<svg
													class="size-3.5 transition-transform group-hover:translate-x-0.5"
													viewBox="0 0 24 24"
													fill="none"
													stroke="currentColor"
													stroke-width="2"
												>
													<path
														d="M5 12h14M13 6l6 6-6 6"
														stroke-linecap="round"
														stroke-linejoin="round"
													/>
												</svg>
											</span>
										</a>
									))
								}
								</div>

									<button
										type="button"
										data-webinar-carousel-next
										class="webinar-carousel-nav webinar-carousel-nav--next"
										aria-label="Ver fechas siguientes"
									>
										<svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
											<path d="M9 18l6-6-6-6" stroke-linecap="round" stroke-linejoin="round"></path>
										</svg>
									</button>
								</div>
							</div>

							<p
								data-webinar-carousel-indicator
								class="mt-3 text-center text-xs text-white/60 sm:text-sm"
								hidden
							></p>

							<div class="mt-4 flex flex-col items-center justify-center gap-3 sm:flex-row sm:flex-wrap">
								<button
									type="button"
									data-webinar-close
									class="inline-flex cursor-pointer items-center gap-2 rounded-full border border-white/25 bg-white/10 px-5 py-2 text-sm font-medium text-white transition-all hover:-translate-y-0.5 hover:border-white/40 hover:bg-white/15 sm:text-base"
								>
									<svg
										class="size-4 shrink-0"
										viewBox="0 0 24 24"
										fill="none"
										stroke="currentColor"
										stroke-width="2"
									>
										<path d="M5 12h14M13 6l6 6-6 6" stroke-linecap="round" stroke-linejoin="round"
										></path>
									</svg>
									Seguir navegando
								</button>
							</div>
						</div>
					</div>
				</div>
			</div>
		</div>
		</div>
	</div>

	<!-- Acciones flotantes: webinar (secundario) + WhatsApp (principal) -->
	<div
		id="webinar-floating-actions"
		class="fixed bottom-8 right-8 z-50 hidden items-end gap-2.5 sm:gap-3"
	>
		<button
			type="button"
			id="webinar-floating-expand"
			class="cursor-pointer webinar-floating-btn hidden items-center gap-1.5 rounded-full border border-white/20 bg-verde-deg-1/95 px-3 py-2 text-white shadow-lg backdrop-blur-sm transition-all hover:-translate-y-0.5 hover:border-crema/40 hover:bg-verde-deg-black focus:outline-none focus-visible:ring-2 focus-visible:ring-verde-claro sm:gap-2 sm:px-3.5 sm:py-2.5"
			aria-label="Ver invitación al webinar"
		>
			<img
				src="/assets/icons/webinar/voice-chat.svg"
				alt=""
				class="size-5 shrink-0 sm:size-6"
				aria-hidden="true"
			/>
			<span class="text-xs font-medium sm:text-sm">Webinar</span>
		</button>

		<a
			id="webinar-floating-whatsapp"
			href={whatsappUrl}
			target="_blank"
			rel="noopener noreferrer"
			class="inline-flex shrink-0 items-center transition-all hover:-translate-y-1"
			aria-label="Contactar por WhatsApp"
		>
			<svg class="size-12 sm:size-14" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 256 258">
				<defs>
					<linearGradient id="webinar-wa-bg" x1="50%" x2="50%" y1="100%" y2="0%">
						<stop offset="0%" stop-color="#1faf38"></stop>
						<stop offset="100%" stop-color="#60d669"></stop>
					</linearGradient>
					<linearGradient id="webinar-wa-fg" x1="50%" x2="50%" y1="100%" y2="0%">
						<stop offset="0%" stop-color="#f9f9f9"></stop>
						<stop offset="100%" stop-color="#fff"></stop>
					</linearGradient>
				</defs>
				<path
					fill="url(#webinar-wa-bg)"
					d="M5.463 127.456c-.006 21.677 5.658 42.843 16.428 61.499L4.433 252.697l65.232-17.104a123 123 0 0 0 58.8 14.97h.054c67.815 0 123.018-55.183 123.047-123.01c.013-32.867-12.775-63.773-36.009-87.025c-23.23-23.25-54.125-36.061-87.043-36.076c-67.823 0-123.022 55.18-123.05 123.004"
				></path>
				<path
					fill="url(#webinar-wa-fg)"
					d="M1.07 127.416c-.007 22.457 5.86 44.38 17.014 63.704L0 257.147l67.571-17.717c18.618 10.151 39.58 15.503 60.91 15.511h.055c70.248 0 127.434-57.168 127.464-127.423c.012-34.048-13.236-66.065-37.3-90.15C194.633 13.286 162.633.014 128.536 0C58.276 0 1.099 57.16 1.071 127.416m40.24 60.376l-2.523-4.005c-10.606-16.864-16.204-36.352-16.196-56.363C22.614 69.029 70.138 21.52 128.576 21.52c28.3.012 54.896 11.044 74.9 31.06c20.003 20.018 31.01 46.628 31.003 74.93c-.026 58.395-47.551 105.91-105.943 105.91h-.042c-19.013-.01-37.66-5.116-53.922-14.765l-3.87-2.295l-40.098 10.513z"
				></path>
				<path
					fill="#fff"
					d="M96.678 74.148c-2.386-5.303-4.897-5.41-7.166-5.503c-1.858-.08-3.982-.074-6.104-.074c-2.124 0-5.575.799-8.492 3.984c-2.92 3.188-11.148 10.892-11.148 26.561s11.413 30.813 13.004 32.94c1.593 2.123 22.033 35.307 54.405 48.073c26.904 10.609 32.379 8.499 38.218 7.967c5.84-.53 18.844-7.702 21.497-15.139c2.655-7.436 2.655-13.81 1.859-15.142c-.796-1.327-2.92-2.124-6.105-3.716s-18.844-9.298-21.763-10.361c-2.92-1.062-5.043-1.592-7.167 1.597c-2.124 3.184-8.223 10.356-10.082 12.48c-1.857 2.129-3.716 2.394-6.9.801c-3.187-1.598-13.444-4.957-25.613-15.806c-9.468-8.442-15.86-18.867-17.718-22.056c-1.858-3.184-.199-4.91 1.398-6.497c1.431-1.427 3.186-3.719 4.78-5.578c1.588-1.86 2.118-3.187 3.18-5.311c1.063-2.126.531-3.986-.264-5.579c-.798-1.593-6.987-17.343-9.819-23.64"
				></path>
			</svg>
		</a>
	</div>
</div>

<style>
	.webinar-title-shadow {
		text-shadow:
			0 1px 2px rgba(0, 0, 0, 1),
			0 2px 8px rgba(0, 0, 0, 0.95),
			0 4px 16px rgba(0, 0, 0, 0.9),
			0 8px 32px rgba(0, 0, 0, 0.85),
			2px 4px 6px rgba(0, 0, 0, 0.8);
	}

	.webinar-flare {
		position: absolute;
		left: 0;
		right: 0;
		height: 4px;
		background: linear-gradient(
			90deg,
			transparent 0%,
			rgba(223, 195, 159, 0.15) 20%,
			rgba(223, 195, 159, 0.7) 50%,
			rgba(223, 195, 159, 0.15) 80%,
			transparent 100%
		);
		pointer-events: none;
	}

	.webinar-flare--top {
		top: 0;
	}

	.webinar-flare--bottom {
		bottom: 0;
	}

	.webinar-bracketed {
		position: relative;
		padding-inline: 2rem;
	}

	.webinar-bracketed::before,
	.webinar-bracketed::after {
		position: absolute;
		top: 40%;
		transform: translateY(-50%);
		font-size: 6rem;
		font-weight: 200;
		line-height: 1;
		color: var(--color-crema);
		opacity: 0.85;
	}

	.webinar-bracketed::before {
		content: "[";
		left: 0;
	}

	.webinar-bracketed::after {
		content: "]";
		right: 0;
	}

	.webinar-info-item {
		display: flex;
		flex: 1;
		flex-direction: column;
		align-items: center;
		justify-content: flex-start;
		gap: 0.35rem;
		min-width: 0;
		text-align: center;
		font-size: 0.65rem;
		line-height: 1.2;
		color: white;
	}

	@media (min-width: 30rem) {
		.webinar-info-item {
			font-size: 0.72rem;
		}
	}

	@media (min-width: 48rem) {
		.webinar-info-item {
			font-size: 0.8rem;
		}
	}

	.webinar-info-icon {
		width: 1.65rem;
		height: auto;
		flex-shrink: 0;
	}

	@media (min-width: 48rem) {
		.webinar-info-icon {
			width: 1.85rem;
		}
	}

	.webinar-info-item--dates {
		flex: 1.15;
		padding-inline: 0.35rem;
	}

	.webinar-summary-text {
		display: block;
		width: 100%;
		padding-inline: 0.25rem;
		line-height: 1.55;
		white-space: pre-line;
	}

	.webinar-info-divider {
		width: 1px;
		align-self: stretch;
		background: rgba(255, 255, 255, 0.25);
		margin-block: 0.15rem;
	}

	.webinar-day-card {
		display: none;
	}

	.webinar-day-card.is-visible {
		display: flex;
	}

	.webinar-carousel {
		width: 100%;
	}

	.webinar-carousel-inner {
		display: grid;
		grid-template-columns: 2.5rem minmax(0, 1fr) 2.5rem;
		align-items: center;
		column-gap: 0.5rem;
	}

	@media (min-width: 40rem) {
		.webinar-carousel-inner {
			grid-template-columns: 2.75rem minmax(0, 1fr) 2.75rem;
			column-gap: 0.75rem;
		}
	}

	.webinar-carousel-track {
		min-width: 0;
	}

	.webinar-carousel-nav {
		display: inline-flex;
		width: 2.5rem;
		height: 2.5rem;
		flex-shrink: 0;
		align-items: center;
		justify-content: center;
		border-radius: 9999px;
		border: 1px solid rgba(255, 255, 255, 0.25);
		background: rgba(255, 255, 255, 0.1);
		color: white;
		cursor: pointer;
		visibility: hidden;
		pointer-events: none;
		opacity: 0;
		transition:
			transform 0.2s ease,
			background-color 0.2s ease,
			border-color 0.2s ease,
			opacity 0.2s ease,
			visibility 0.2s ease;
	}

	.webinar-carousel-nav.is-visible {
		visibility: visible;
		pointer-events: auto;
		opacity: 1;
	}

	.webinar-carousel--single .webinar-carousel-inner {
		grid-template-columns: minmax(0, 1fr);
	}

	.webinar-carousel--single .webinar-carousel-nav {
		display: none;
	}

	.webinar-carousel-nav:hover {
		transform: translateY(-1px);
		border-color: rgba(255, 255, 255, 0.4);
		background: rgba(255, 255, 255, 0.15);
	}

	.webinar-carousel-nav:focus-visible {
		outline: 2px solid var(--color-verde-claro);
		outline-offset: 2px;
	}

	.webinar-modal {
		-webkit-overflow-scrolling: touch;
	}

	.webinar-modal.is-open {
		opacity: 1;
		pointer-events: auto;
	}

	.webinar-modal.is-open .webinar-card {
		transform: translateY(0) scale(1);
	}

	#webinar-floating-actions.is-visible {
		display: flex;
	}

	.webinar-floating-btn.is-visible {
		display: inline-flex;
	}

	:global(body.webinar-modal-open) {
		overflow: hidden;
	}
</style>

<script>
	const STORAGE_KEY = "btobcomex-webinar-seen";
	const SHOW_DELAY_MS = 1200;
	type ScheduledWebinar = {
		id: string;
		label: string;
		shortLabel: string;
		dateLabel: string;
		summaryDateLabel: string;
		time: string;
		summaryTime: string;
		startAt: string;
		endAt: string;
	};

	function initWebinarWidget() {
		const widget = document.getElementById("webinar-widget");
		const modal = document.getElementById("webinar-modal");
		const floatingActions = document.getElementById("webinar-floating-actions");
		const expandBtn = document.getElementById("webinar-floating-expand");
		const summaryDate = widget?.querySelector<HTMLElement>("[data-webinar-summary-date]");
		const summaryTime = widget?.querySelector<HTMLElement>("[data-webinar-summary-time]");
		const carousel = widget?.querySelector<HTMLElement>(".webinar-carousel");
		const carouselPrev = widget?.querySelector<HTMLButtonElement>("[data-webinar-carousel-prev]");
		const carouselNext = widget?.querySelector<HTMLButtonElement>("[data-webinar-carousel-next]");
		const carouselIndicator = widget?.querySelector<HTMLElement>("[data-webinar-carousel-indicator]");
		const cards = widget
			? Array.from(widget.querySelectorAll<HTMLElement>("[data-webinar-card]"))
			: [];

		if (!widget || !modal || !floatingActions || widget.dataset.ready === "1") return;
		widget.dataset.ready = "1";

		const scheduledWebinars = JSON.parse(widget.dataset.webinars ?? "[]") as ScheduledWebinar[];
		let showTimeout: ReturnType<typeof setTimeout> | undefined;
		let availabilityTimeout: ReturnType<typeof setTimeout> | undefined;
		let activeWebinars = getActiveWebinars();
		let dayGroups: string[] = [];
		let currentSlideIndex = 0;
		let visibleWebinars: ScheduledWebinar[] = [];

		function getActiveWebinars(now = Date.now()) {
			return scheduledWebinars
				.filter((webinar) => {
					const endAt = Date.parse(webinar.endAt);
					return Number.isFinite(endAt) && endAt > now;
				})
				.sort((first, second) => Date.parse(first.startAt) - Date.parse(second.startAt));
		}

		function getDayGroups(now = Date.now()) {
			const upcoming = getActiveWebinars(now);
			const dates: string[] = [];

			for (const webinar of upcoming) {
				const dateKey = webinar.startAt.slice(0, 10);
				if (!dates.includes(dateKey)) dates.push(dateKey);
			}

			return dates;
		}

		function getWebinarsForDay(dateKey: string, now = Date.now()) {
			return getActiveWebinars(now).filter((webinar) => webinar.startAt.slice(0, 10) === dateKey);
		}

		function getDayLabel(dateKey: string) {
			const webinar = scheduledWebinars.find((item) => item.startAt.slice(0, 10) === dateKey);
			return webinar?.label ?? dateKey;
		}

		function showCurrentSlide(now = Date.now()) {
			const currentDate = dayGroups[currentSlideIndex];
			if (!currentDate) {
				visibleWebinars = [];
				cards.forEach((card) => card.classList.remove("is-visible"));
				return;
			}

			visibleWebinars = getWebinarsForDay(currentDate, now);
			const visibleIds = new Set(visibleWebinars.map(({ id }) => id));

			cards.forEach((card) => {
				card.classList.toggle("is-visible", visibleIds.has(card.dataset.webinarId ?? ""));
			});
		}

		function updateCarouselNav() {
			const hasMultipleDays = dayGroups.length > 1;

			carousel?.classList.toggle("webinar-carousel--single", !hasMultipleDays);

			carouselPrev?.classList.toggle("is-visible", hasMultipleDays && currentSlideIndex > 0);
			carouselNext?.classList.toggle(
				"is-visible",
				hasMultipleDays && currentSlideIndex < dayGroups.length - 1,
			);

			if (!carouselIndicator) return;

			if (hasMultipleDays) {
				const currentDate = dayGroups[currentSlideIndex];
				carouselIndicator.hidden = false;
				carouselIndicator.textContent = `${getDayLabel(currentDate)} · ${currentSlideIndex + 1} de ${dayGroups.length}`;
			} else {
				carouselIndicator.hidden = true;
				carouselIndicator.textContent = "";
			}
		}

		function getSeenWebinarId() {
			try {
				return localStorage.getItem(STORAGE_KEY);
			} catch {
				return null;
			}
		}

		function markWebinarAsSeen() {
			const nextWebinar = visibleWebinars[0];
			if (!nextWebinar) return;

			try {
				localStorage.setItem(STORAGE_KEY, nextWebinar.id);
			} catch {
				// El widget sigue funcionando aunque el navegador bloquee localStorage.
			}
		}

		const showFloating = (withWebinarBtn: boolean) => {
			floatingActions.classList.add("is-visible");
			if (withWebinarBtn) {
				expandBtn?.classList.add("is-visible");
			} else {
				expandBtn?.classList.remove("is-visible");
			}
		};

		const hideFloating = () => {
			floatingActions.classList.remove("is-visible");
		};

		const openModal = () => {
			if (!dayGroups.length) return;

			clearTimeout(showTimeout);
			hideFloating();
			modal.classList.add("is-open");
			modal.setAttribute("aria-hidden", "false");
			document.body.classList.add("webinar-modal-open");
		};

		const dismissModal = (persist = true) => {
			clearTimeout(showTimeout);
			modal.classList.remove("is-open");
			modal.setAttribute("aria-hidden", "true");
			document.body.classList.remove("webinar-modal-open");

			if (persist) {
				markWebinarAsSeen();
			}

			showFloating(dayGroups.length > 0);
		};

		const updateSummary = () => {
			if (!activeWebinars.length) return;

			const dates = [...new Set(activeWebinars.map(({ summaryDateLabel }) => summaryDateLabel))].join("\n");
			const times = [...new Set(visibleWebinars.map(({ summaryTime }) => summaryTime))].join(" y ");
			if (summaryDate) summaryDate.textContent = dates;
			if (summaryTime) summaryTime.textContent = times;
		};

		const scheduleAvailabilityCheck = () => {
			clearTimeout(availabilityTimeout);
			const nextEndAt = activeWebinars.reduce((soonest, webinar) => {
				const endAt = Date.parse(webinar.endAt);
				return endAt < soonest ? endAt : soonest;
			}, Number.POSITIVE_INFINITY);

			if (!Number.isFinite(nextEndAt)) return;

			const delay = Math.max(nextEndAt - Date.now() + 100, 0);
			availabilityTimeout = setTimeout(refreshAvailability, Math.min(delay, 2_147_483_647));
		};

		function refreshAvailability() {
			activeWebinars = getActiveWebinars();
			dayGroups = getDayGroups();

			if (!dayGroups.length) {
				currentSlideIndex = 0;
				showCurrentSlide();
				updateCarouselNav();
				clearTimeout(showTimeout);
				if (modal.classList.contains("is-open")) dismissModal(false);
				showFloating(false);
				return;
			}

			if (currentSlideIndex >= dayGroups.length) {
				currentSlideIndex = dayGroups.length - 1;
			}

			showCurrentSlide();
			updateSummary();
			updateCarouselNav();

			if (!modal.classList.contains("is-open")) showFloating(true);
			scheduleAvailabilityCheck();
		}

		carouselPrev?.addEventListener("click", () => {
			if (currentSlideIndex <= 0) return;
			currentSlideIndex -= 1;
			showCurrentSlide();
			updateSummary();
			updateCarouselNav();
		});

		carouselNext?.addEventListener("click", () => {
			if (currentSlideIndex >= dayGroups.length - 1) return;
			currentSlideIndex += 1;
			showCurrentSlide();
			updateSummary();
			updateCarouselNav();
		});

		modal.querySelectorAll("[data-webinar-close]").forEach((el) => {
			el.addEventListener("click", () => dismissModal(true));
		});

		expandBtn?.addEventListener("click", openModal);

		document.addEventListener("keydown", (event) => {
			if (event.key === "Escape" && modal.classList.contains("is-open")) {
				dismissModal(true);
			}
		});

		refreshAvailability();
		const hasUnseenWebinar =
			dayGroups.length > 0 && getSeenWebinarId() !== getWebinarsForDay(dayGroups[0])[0]?.id;

		if (hasUnseenWebinar) {
			showFloating(false);
			showTimeout = setTimeout(openModal, SHOW_DELAY_MS);
		}
	}

	document.addEventListener("astro:page-load", initWebinarWidget);
</script>

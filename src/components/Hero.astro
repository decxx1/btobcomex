---
import CantonLogo from "@/components/CantonLogo.astro";
import { SOCIAL_WHATSAPP_URL } from "astro:env/client";

interface Props {
	bgImage?: string;
	title?: string;
	showBottomBar?: boolean;
}

const {
	bgImage,
	title,
	showBottomBar,
} = Astro.props;

const whatsappUrl = SOCIAL_WHATSAPP_URL ?? "";
---

<section class="relative h-dvh w-full overflow-hidden font-montserrat">
	<!-- Background Image -->
	<div class="absolute inset-0 z-0">
		<img
			src={bgImage}
			alt="Hero Background"
			class="w-full h-full object-cover"
		/>
		<!-- Dark Overlay -->
		<div class="absolute inset-0 mask-b-from-10% mask-b-to-60% bg-black/70">
		</div>
	</div>

	<!-- Right Arrow Mask Overlay -->
	<!-- Positioned absolutely to the right, taking up full height -->
	<div
		class="absolute top-0 right-0 h-full w-[60%] lg:w-[40%] z-10 pointer-events-none hidden md:block"
	>
		<img
			src="/assets/elements/arrow-right.svg"
			alt="elemento decorativo"
			class="h-full w-full object-cover object-left opacity-20 mix-blend-multiply"
		/>
	</div>

	<!-- Content -->
	<div
		class="relative z-20 container mx-auto h-full flex flex-col justify-center px-4 md:px-12 text-white pt-20"
	>
		<h1
			class="max-sm:text-center text-3xl sm:text-4xl md:text-5xl xl:text-6xl font-bold leading-tight max-w-3xl xl:max-w-4xl shadow-xx"
			set:html={title}
		/>
	</div>

	<!-- Bottom Elements -->
	{
		showBottomBar && (
			<div class="absolute bottom-0 left-0 w-full z-30">
				<div class="container mx-auto flex flex-col md:flex-row items-start md:items-center gap-6 md:gap-12 pb-12 md:pb-16">
					<!-- Anniversary Badge (Red Bar) -->
					<CantonLogo />

					<a
						href={whatsappUrl}
						target="_blank"
						rel="noopener noreferrer"
						class="group bg-radial from-rojo to-[#6d0000] hover:bg-[#6d0000] text-white py-1 xl:py-2 px-6 xl:px-8 rounded-tr-2xl rounded-tl-2xl rounded-bl-2xl flex flex-col items-start text-left transition-all shadow-lg hover:shadow-xl hover:-translate-y-1"
					>
						<span class="text-lg xl:text-xl font-semibold 2xl:font-bold">
							Reservá tu lugar
						</span>
						<span
							class="text-sm xl:text-base font-light xl:font-medium opacity-90 min-h-[1.5em] inline-block"
							id="dynamic-hero-btn"
						>
						</span>
					</a>
				</div>
			</div>
		)
	}
</section>

<script>
	document.addEventListener("astro:page-load", () => {
		const today = new Date();
		const currentYear = today.getFullYear();
		const currentMonth = today.getMonth();
		const currentDay = today.getDate();

		let targetMonthName = "Abril";
		let targetYear = currentYear;

		if (currentMonth > 9 || (currentMonth === 9 && currentDay >= 10)) {
			targetMonthName = "Abril";
			targetYear = currentYear + 1;
		} else if (currentMonth > 3 || (currentMonth === 3 && currentDay >= 10)) {
			targetMonthName = "Octubre";
			targetYear = currentYear;
		} else {
			targetMonthName = "Abril";
			targetYear = currentYear;
		}

		const dynamicText = `${targetMonthName} ${targetYear}`;

		const btnEl = document.getElementById("dynamic-hero-btn");
		if (btnEl) btnEl.textContent = `Feria de Cantón ${dynamicText}`;
	});
</script>

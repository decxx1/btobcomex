---
import { CONTACT_PHONE_1, CONTACT_PHONE_2, CONTACT_PHONE_3, CONTACT_EMAIL, CONTACT_WEBSITE, SOCIAL_LINKEDIN_URL,SOCIAL_FACEBOOK_URL, SOCIAL_INSTAGRAM_URL } from "astro:env/client";

const phone1 = CONTACT_PHONE_1 ?? "";
const phone2 = CONTACT_PHONE_2 ?? "";
const phone3 = CONTACT_PHONE_3 ?? "";
const email = CONTACT_EMAIL ?? "";
const website = CONTACT_WEBSITE ?? "";

const linkedinUrl = SOCIAL_LINKEDIN_URL ?? "";
const instagramUrl = SOCIAL_INSTAGRAM_URL ?? "";
const faceUrl = SOCIAL_FACEBOOK_URL ?? "";
---

<footer
	class="bg-linear-to-r from-verde-deg-1 to-verde-deg-2 text-white py-8 lg:py-12 font-montserrat"
>
	<div class="container mx-auto px-4 md:px-12">
		<div
			class="flex flex-col md:flex-row items-center md:items-start justify-between gap-8 md:gap-10"
		>
			<!-- Logo izquierda -->
			<div class="md:w-1/3 flex justify-center md:justify-start">
				<a href="/" class="hover:scale-110 transition-all duration-300">
					<img
						src="/assets/logos/logo-mini-white.svg"
						alt="B TO B Comex"
						class="h-16 md:h-20 xl:h-24"
					/>
				</a>
			</div>

			<!-- Datos de contacto + web centro -->
			<div class="md:w-1/3 flex flex-col items-center text-center gap-3">
				<div
					class="flex flex-col md:flex-row items-center gap-3 text-base sm:text-lg font-light"
				>
					<div class="flex max-2xl:flex-col gap-3">
						<div class="inline-flex gap-2">
							<img
								src="/assets/icons/contact/icon-tel.svg"
								alt="Teléfono"
								class="size-4 sm:size-6"
							/>
							<a href={`tel:${phone1}`} class="hover:font-medium transition-all duration-300"
							>{phone1}</a>
						</div>
						<span class="hidden 2xl:block">/</span>
						<div class="inline-flex gap-2">
							<img
								src="/assets/icons/contact/icon-tel.svg"
								alt="Teléfono"
								class="2xl:hidden size-4 sm:size-6"
							/>
							<a href={`tel:${phone2}`} class="hover:font-medium transition-all duration-300"
							>{phone2}</a>
						</div>
					</div>
				</div>
				<div
					class="flex flex-col md:flex-row items-center gap-3 text-base sm:text-lg font-light"
				>
					<div class="flex max-2xl:flex-col gap-3">
						<div class="inline-flex gap-2">
							<img
								src="/assets/icons/contact/icon-tel.svg"
								alt="Teléfono"
								class="size-4 sm:size-6"
							/>
							<a href={`tel:${phone3}`} class="hover:font-medium transition-all duration-300"
							>{phone3}</a>
						</div>
					</div>
				</div>
				<div
					class="flex items-center gap-3 text-base sm:text-lg font-light"
				>
					<img
						src="/assets/icons/contact/icon-email.svg"
						alt="Email"
						class="size-4 sm:size-6"
					/>
					<a href={`mailto:${email}`} class="hover:font-medium transition-all duration-300"
						>{email}</a
					>
				</div>
				<div
					class="text-lg sm:text-xl sm:tracking-widest font-light"
				>
					{website}
				</div>
			</div>

			<!-- Redes sociales derecha -->
			<div class="md:w-1/3 flex justify-center md:justify-end mt-4 md:mt-0">
				<div class="flex gap-4">
					<a href={linkedinUrl} class="hover:opacity-80 hover:scale-110 transition-all duration-300">
						<img
							src="/assets/icons/social/icon-linkedin.svg"
							alt="LinkedIn"
							class="size-8 md:size-10"
						/>
					</a>
					<a href={instagramUrl} class="hover:opacity-80 hover:scale-110 transition-all duration-300">
						<img
							src="/assets/icons/social/icon-instagram.svg"
							alt="Instagram"
							class="size-8 md:size-10"
						/>
					</a>
					<a href={faceUrl} class="hover:opacity-80 hover:scale-110 transition-all duration-300">
						<img
							src="/assets/icons/social/icon-facebook.svg"
							alt="Facebook"
							class="size-8 md:size-10"
						/>
					</a>
				</div>
			</div>
		</div>
	</div>
</footer>

---
interface Partner {
	name: string;
	logo: string;
	link: string;
}

interface Props {
	type: "partners" | "socios";
}

const { type } = Astro.props;

const partners: Partner[] = [
	{
		name: "Pronave",
		logo: "/assets/logos/partners/color/pronave.svg",
		link: "https://www.pronave.com.ar/",
	},
	{
		name: "Tahan",
		logo: "/assets/logos/partners/color/tahan.svg",
		link: "https://empresastahan.com/",
	},
	{
		name: "Marpacifico",
		logo: "/assets/logos/partners/color/marpacifico.svg",
		link: "https://www.marpacifico.com",
	}
];

const socios: Partner[] = [
	{
		name: "Cámara de Comercio",
		logo: "/assets/logos/partners/camara-argentino-china.svg",
		link: "https://www.pronave.com.ar/",
	},
	{
		name: "Capromim",
		logo: "/assets/logos/partners/color/capromim.svg",
		link: "#",
	},
];

const logos = type === "socios" ? socios : partners;
---

<section class="bg-white py-8 lg:py-12">
	<div class="container mx-auto px-4 md:px-12">
		<div class="flex flex-wrap items-center justify-center gap-12 lg:gap-16">
			{logos.map((partner) => (
				<a href={partner.link} rel="noopener noreferrer" target="_blank" class="hover:scale-110 transition-all duration-300">
					<img 
						src={partner.logo} 
						alt={partner.name} 
						class={partner.name === "Marpacifico" 
							? "w-32 md:w-36 lg:w-44 h-auto max-h-12 md:max-h-14 lg:max-h-20 aspect-auto" 
							: "w-24 md:w-28 lg:w-36 h-auto max-h-10 md:max-h-12 lg:max-h-16 aspect-auto"}
					/>
				</a>
			))}
		</div>
	</div>
</section>

---
interface Partner {
	name: string;
	logo: string;
}

const partners: Partner[] = [
	{
		name: "Pronave",
		logo: "/assets/logos/partners/logo-pronave.svg",
	},
	{
		name: "Tahan",
		logo: "/assets/logos/partners/tahan.svg",
	},
	{
		name: "Capromim",
		logo: "/assets/logos/partners/logo-capromim.svg",
	},
	{
		name: "Marpacifico",
		logo: "/assets/logos/partners/logo-marpacifico.svg",
	}
];
---

<section class="bg-white py-16 lg:py-24">
	<div class="container mx-auto px-4 md:px-12">
		<div class="flex flex-wrap items-center justify-center gap-12 lg:gap-16">
			{partners.map((partner) => (
				<img 
					src={partner.logo} 
					alt={partner.name} 
					class={partner.name === "Marpacifico" 
						? "w-32 md:w-36 lg:w-44 h-auto max-h-12 md:max-h-14 lg:max-h-20 aspect-auto" 
						: "w-24 md:w-28 lg:w-36 h-auto max-h-10 md:max-h-12 lg:max-h-16 aspect-auto"}
				/>
			))}
		</div>
	</div>
</section>
